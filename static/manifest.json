{
	"manifest_version": 3,
	"name": "Twitch Live Captions",
	"version": "0.2.0",
	"description": "Realtime English captions for any Twitch stream, powered by on-device speech recognition or Deepgram.",
	"minimum_chrome_version": "124",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Twitch Live Captions",
		"default_popup": "settings.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"options_ui": {
		"page": "settings.html?view=options",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": [
		"offscreen",
		"storage"
	],
	"content_scripts": [
		{
			"matches": [
				"https://*.twitch.tv/*"
			],
			"js": [
				"content.js"
			],
			"css": [
				"content.css"
			],
			"all_frames": true,
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"audio-worklet.js"
			],
			"matches": [
				"https://*.twitch.tv/*"
			]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	}
}
